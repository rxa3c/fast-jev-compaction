# Copy this file to .env and fill in your TypeSafe key.
# .env is ignored by git and is read by the Codex hook and CLI.
# For an installed plugin, use ~/.config/fast-jev-compaction/.env instead.
TYPESAFE_API_KEY=

# Optional Jev settings.
FAST_JEV_MODEL=jev-latest
FAST_JEV_MIN_REDUCTION_RATIO=0.25
FAST_JEV_NOTE_RESULT_CHARS=800
FAST_JEV_KEEP_THRESHOLD=0.5
FAST_JEV_PRESERVE_RECENT_MESSAGES=6
FAST_JEV_MAX_STATE_TOKENS=25000
FAST_JEV_MAX_REQUEST_TOKENS=30000
FAST_JEV_TRUNCATE_HEAD_CHARS=300
