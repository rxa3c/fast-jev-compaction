{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/codex-hook.js\"",
            "timeout": 600,
            "statusMessage": "Fast Jev is reviewing Codex history"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/codex-hook.js\"",
            "timeout": 30,
            "additionalContextLimit": 6000,
            "statusMessage": "Loading Fast Jev recovery note"
          }
        ]
      }
    ]
  }
}
